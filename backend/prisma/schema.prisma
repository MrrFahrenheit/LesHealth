generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model les_routine_event {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routine_id       String           @db.Uuid
  title            String           @db.VarChar(90)
  description      String?
  event_type       routine_type
  is_pending       Boolean          @default(true)
  scheduled_for    DateTime?        @db.Timestamptz(6)
  completed_at     DateTime?        @db.Timestamptz(6)
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  les_user_routine les_user_routine @relation(fields: [routine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_user {
  id                                                               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                            String                       @unique
  password_hash                                                    String
  full_name                                                        String                       @db.VarChar(100)
  role                                                             user_role?                   @default(patient)
  specialty                                                        String?                      @db.VarChar(100)
  license_number                                                   String?                      @db.VarChar(50)
  created_at                                                       DateTime?                    @default(now()) @db.Timestamptz(6)
  isemailverified                                                  Boolean                      @default(false)
  verification_token                                               String?
  verification_expires                                             DateTime?                    @db.Timestamptz(6)
  avatar_url                                                       String?
  les_community_group_member                                       les_community_group_member[]
  les_doctor_profile                                               les_doctor_profile?
  les_post                                                         les_post[]
  les_post_bookmark                                                les_post_bookmark[]
  les_post_comment                                                 les_post_comment[]
  les_post_like                                                    les_post_like[]
  les_sesion                                                       les_sesion[]
  les_notification                                                 les_notification[]
  les_user_medical_info                                            les_user_medical_info?
  les_user_prescription_les_user_prescription_doctor_idToles_user  les_user_prescription[]      @relation("les_user_prescription_doctor_idToles_user")
  les_user_prescription_les_user_prescription_patient_idToles_user les_user_prescription[]      @relation("les_user_prescription_patient_idToles_user")
  les_user_reservation_les_user_reservation_doctor_idToles_user    les_user_reservation[]       @relation("les_user_reservation_doctor_idToles_user")
  les_user_reservation_les_user_reservation_patient_idToles_user   les_user_reservation[]       @relation("les_user_reservation_patient_idToles_user")
  les_user_routine                                                 les_user_routine[]
  les_user_sign                                                    les_user_sign[]
}

model les_user_medical_info {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id         String    @unique @db.Uuid
  blood_type         String?   @db.VarChar(5)
  allergies          String?
  chronic_conditions String?
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  les_user           les_user  @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_user_prescription {
  id                                                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id                                          String    @db.Uuid
  doctor_id                                           String    @db.Uuid
  description                                         String
  prescribed_date                                     DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at                                          DateTime? @default(now()) @db.Timestamptz(6)
  les_user_les_user_prescription_doctor_idToles_user  les_user  @relation("les_user_prescription_doctor_idToles_user", fields: [doctor_id], references: [id], onUpdate: NoAction)
  les_user_les_user_prescription_patient_idToles_user les_user  @relation("les_user_prescription_patient_idToles_user", fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  les_prescription_item                               les_prescription_item[]
}

model les_prescription_item {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prescription_id       String                @db.Uuid
  medication_name       String                @db.VarChar(150)
  dosage                String                @db.VarChar(100)
  frequency             String                @db.VarChar(100)
  duration_days         Int?
  notes                 String?
  les_user_prescription les_user_prescription @relation(fields: [prescription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_user_reservation {
  id                                                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id                                         String    @db.Uuid
  doctor_id                                          String    @db.Uuid
  reservation_date                                   DateTime  @db.Timestamptz(6)
  status                                             String?   @default("pending") @db.VarChar(20)
  notes                                              String?
  created_at                                         DateTime? @default(now()) @db.Timestamptz(6)
  les_user_les_user_reservation_doctor_idToles_user  les_user  @relation("les_user_reservation_doctor_idToles_user", fields: [doctor_id], references: [id], onUpdate: NoAction)
  les_user_les_user_reservation_patient_idToles_user les_user  @relation("les_user_reservation_patient_idToles_user", fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_user_routine {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @db.Uuid
  title             String              @db.VarChar(100)
  description       String?
  frequency         String?             @db.VarChar(50)
  is_active         Boolean?            @default(true)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  les_routine_event les_routine_event[]
  les_user          les_user            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_user_sign {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id String    @db.Uuid
  type       String    @db.VarChar(90)
  value      Decimal   @db.Decimal(8, 2)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  les_user   les_user  @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_sesion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  refresh_token String   @unique
  user_agent    String?
  ip_address    String?  @db.VarChar(45)
  is_revoked    Boolean  @default(false)
  expires_at    DateTime @db.Timestamptz(6)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  les_user      les_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_les_sesion_user_active", where: raw("(is_revoked = false)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model les_doctor_profile {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String                @unique @db.Uuid
  name                String                @db.VarChar(150)
  specialty           String                @db.VarChar(100)
  rating              Decimal               @default(0.0) @db.Decimal(2, 1)
  reviews_count       Int                   @default(0)
  experience_years    Int                   @default(0)
  location            String                @db.VarChar(120)
  modality            consultation_modality @default(Presencial)
  availability_status String                @default("Disponible") @db.VarChar(100)
  image_url           String?
  is_featured         Boolean               @default(false)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  les_user            les_user              @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_doctor_user")

  @@index([is_featured], map: "idx_doctor_featured")
  @@index([location], map: "idx_doctor_location")
  @@index([specialty], map: "idx_doctor_specialty")
}

model les_community_group {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String                       @db.VarChar(120)
  description                String?
  image_url                  String?
  created_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  les_community_group_member les_community_group_member[]
  les_post                   les_post[]
}

model les_community_group_member {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id            String              @db.Uuid
  user_id             String              @db.Uuid
  joined_at           DateTime?           @default(now()) @db.Timestamptz(6)
  les_community_group les_community_group @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  les_user            les_user            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, user_id], map: "uq_group_user")
}

model les_post {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id           String               @db.Uuid
  group_id            String?              @db.Uuid
  content             String
  image_url           String?
  tags                String[]             @db.VarChar(50)
  category            post_category?       @default(general)
  created_at          DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?            @default(now()) @db.Timestamptz(6)
  les_user            les_user             @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  les_community_group les_community_group? @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  les_post_bookmark   les_post_bookmark[]
  les_post_comment    les_post_comment[]
  les_post_like       les_post_like[]

  @@index([created_at(sort: Desc)], map: "idx_les_post_created_at")
  @@index([group_id], map: "idx_les_post_group")
}

model les_post_bookmark {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String    @db.Uuid
  user_id    String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  les_post   les_post  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  les_user   les_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([post_id, user_id], map: "uq_post_user_bookmark")
}

model les_post_comment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String    @db.Uuid
  author_id  String    @db.Uuid
  content    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  les_user   les_user  @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  les_post   les_post  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_post_like {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String    @db.Uuid
  user_id    String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  les_post   les_post  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  les_user   les_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([post_id, user_id], map: "uq_post_user_like")
}

enum routine_type {
  exercise
  medication
}

enum user_role {
  patient
  doctor
  admin
  guest
}

enum consultation_modality {
  Presencial
  Virtual
  Hibrida
}

enum post_category {
  general
  question
  experience
  advice
}

model les_notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  title      String    @db.VarChar(120)
  message    String
  type       String    @db.VarChar(50)
  is_read    Boolean   @default(false)
  link_url   String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  les_user   les_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read], map: "idx_notification_user_read")
}
