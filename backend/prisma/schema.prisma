generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model les_routine_event {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routine_id       String           @db.Uuid
  title            String           @db.VarChar(90)
  description      String?
  event_type       routine_type
  is_pending       Boolean          @default(true)
  scheduled_for    DateTime?        @db.Timestamptz(6)
  completed_at     DateTime?        @db.Timestamptz(6)
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  les_user_routine les_user_routine @relation(fields: [routine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_user {
  id                                                               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                            String                  @unique
  password_hash                                                    String
  full_name                                                        String                  @db.VarChar(100)
  role                                                             user_role               @default(patient)
  specialty                                                        String?                 @db.VarChar(100)
  license_number                                                   String?                 @db.VarChar(50)
  created_at                                                       DateTime?               @default(now()) @db.Timestamptz(6)
  les_sesion                                                       les_sesion[]
  les_user_medical_info                                            les_user_medical_info?
  les_user_prescription_les_user_prescription_doctor_idToles_user  les_user_prescription[] @relation("les_user_prescription_doctor_idToles_user")
  les_user_prescription_les_user_prescription_patient_idToles_user les_user_prescription[] @relation("les_user_prescription_patient_idToles_user")
  les_user_reservation_les_user_reservation_doctor_idToles_user    les_user_reservation[]  @relation("les_user_reservation_doctor_idToles_user")
  les_user_reservation_les_user_reservation_patient_idToles_user   les_user_reservation[]  @relation("les_user_reservation_patient_idToles_user")
  les_user_routine                                                 les_user_routine[]
  les_user_sign                                                    les_user_sign[]
}

model les_user_medical_info {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id         String    @unique @db.Uuid
  blood_type         String?   @db.VarChar(5)
  allergies          String?
  chronic_conditions String?
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  les_user           les_user  @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_user_prescription {
  id                                                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id                                          String    @db.Uuid
  doctor_id                                           String    @db.Uuid
  description                                         String
  prescribed_date                                     DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at                                          DateTime? @default(now()) @db.Timestamptz(6)
  les_user_les_user_prescription_doctor_idToles_user  les_user  @relation("les_user_prescription_doctor_idToles_user", fields: [doctor_id], references: [id], onUpdate: NoAction)
  les_user_les_user_prescription_patient_idToles_user les_user  @relation("les_user_prescription_patient_idToles_user", fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_user_reservation {
  id                                                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id                                         String    @db.Uuid
  doctor_id                                          String    @db.Uuid
  reservation_date                                   DateTime  @db.Timestamptz(6)
  status                                             String?   @default("pending") @db.VarChar(20)
  notes                                              String?
  created_at                                         DateTime? @default(now()) @db.Timestamptz(6)
  les_user_les_user_reservation_doctor_idToles_user  les_user  @relation("les_user_reservation_doctor_idToles_user", fields: [doctor_id], references: [id], onUpdate: NoAction)
  les_user_les_user_reservation_patient_idToles_user les_user  @relation("les_user_reservation_patient_idToles_user", fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_user_routine {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @db.Uuid
  title             String              @db.VarChar(100)
  description       String?
  frequency         String?             @db.VarChar(50)
  is_active         Boolean?            @default(true)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  les_routine_event les_routine_event[]
  les_user          les_user            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_user_sign {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id String    @db.Uuid
  type       String    @db.VarChar(90)
  value      Decimal   @db.Decimal(8, 2)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  les_user   les_user  @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model les_sesion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  refresh_token String   @unique
  user_agent    String?
  ip_address    String?  @db.VarChar(45)
  is_revoked    Boolean  @default(false)
  expires_at    DateTime @db.Timestamptz(6)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  les_user      les_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_les_sesion_user_active", where: raw("(is_revoked = false)"))
}

enum routine_type {
  exercise
  medication
}

enum user_role {
  patient
  doctor
  admin
  guest
}
